<?xml version="1.0" encoding="UTF-8"?>
<!-- Emergency-vehicle trips for the city-wide multi-EMV routing extension
     (Section 3.2), generated for the manhattan scenario so the with/without
     EMV-routing comparison (Section 6.1) is meaningful here too: manhattan's
     base scenario files ship with no emergency vehicles at all. Lives in a
     separate emv/ subfolder with its own sumocfg so the original, working
     manhattan.sumocfg and route files are left untouched. from/to edge pairs
     are real start/end edges reused from manhattan's own base route file, so
     they are guaranteed routable. Same vType and depart-offset pattern as
     scenarios/cologne8/cologne8_emv.rou.xml. -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://sumo.dlr.de/xsd/routes_file.xsd">
	<vType id="emergency" vClass="emergency" speedFactor="1.3" length="6.0" minGap="1.0" guiShape="emergency"/>
	<trip id="emv_0" type="emergency" depart="60.00" from="5672036#5" to="439768850#1"/>
	<trip id="emv_1" type="emergency" depart="420.00" from="988977545#0" to="1117867040#1"/>
	<trip id="emv_2" type="emergency" depart="780.00" from="384649120#2" to="743358444#1"/>
	<trip id="emv_3" type="emergency" depart="1140.00" from="441405436#5" to="46520921#4"/>
